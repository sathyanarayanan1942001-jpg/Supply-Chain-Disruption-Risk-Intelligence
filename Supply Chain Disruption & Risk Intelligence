# 3. Inventory Risk Analysis Engine
# ---------------------------------------------------------
def calculate_inventory_risk(df_inventory, df_suppliers_scored):
    """
    Evaluates inventory coverage, safety stock shortfall, and replenishment risks.
    Handles zero consumption and links to supplier health.
    """
    df = df_inventory.copy()

    # Merge supplier risk category
    sup_map = df_suppliers_scored.set_index("supplier_id")["risk_category"].to_dict()
    df["supplier_risk_category"] = df["primary_supplier_id"].map(sup_map).fillna("Low")

    # Safe Days of Inventory Remaining calculation
    # If consumption is 0, coverage is functionally infinite (represented as 999 days)
    df["days_of_inventory_remaining"] = df.apply(
        lambda r: round(r["current_stock"] / r["avg_daily_consumption"], 1) if r["avg_daily_consumption"] > 0 else 999.0,
        axis=1
    )

    # Safety stock shortfall
    df["safety_stock_shortfall"] = (df["safety_stock"] - df["current_stock"]).apply(lambda x: max(0, x))

    # Required coverage threshold = Reorder Lead Time + 4 Days Buffer
    safety_buffer_days = 4
    df["coverage_target_days"] = df["reorder_lead_time_days"] + safety_buffer_days

    # Stockout Risk Categorization
    def categorize_inventory(row):
        days_left = row["days_of_inventory_remaining"]
        lead_time = row["reorder_lead_time_days"]
        target = row["coverage_target_days"]

        # High risk: Stock runs out before replenishment lead time
        if days_left <= lead_time:
            return "High"
        # Medium risk: Stock runs out before replenishment + buffer, or stock is below safety threshold
        elif days_left <= target or row["safety_stock_shortfall"] > 0 or row["supplier_risk_category"] == "High":
            return "Medium"
        return "Low"

    df["stockout_risk_category"] = df.apply(categorize_inventory, axis=1)
    return df


