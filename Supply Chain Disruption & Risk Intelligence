# ---------------------------------------------------------
# 2. Supplier Risk Analysis Engine
# ---------------------------------------------------------
def calculate_supplier_risk(df_suppliers):
    """
    Computes a transparent 0-100 supplier risk score based on:
    - On-time delivery performance (up to 35 points)
    - Defect rate (up to 25 points)
    - Lead time deviation percentage (up to 20 points)
    - Active disruption indicator (20 points)
    """
    df = df_suppliers.copy()

    # Factor 1: On-time delivery penalty (OTD < 95% incurs penalty)
    # 100% OTD -> 0 penalty; 50% OTD -> 35 penalty
    otd_penalty = df["on_time_delivery_rate"].apply(
        lambda rate: max(0.0, min(35.0, (1.0 - rate) * 70.0))
    )

    # Factor 2: Defect rate penalty (Defects > 0.5% penalized, capped at 10% -> 25 points)
    defect_penalty = df["defect_rate"].apply(
        lambda dr: max(0.0, min(25.0, (dr / 0.08) * 25.0))
    )

    # Factor 3: Lead time variance penalty (avg vs promised)
    lead_time_variance = df.apply(
        lambda row: max(0.0, (row["avg_lead_time_days"] - row["promised_lead_time_days"]) / max(1, row["promised_lead_time_days"])),
        axis=1
    )
    lt_penalty = lead_time_variance.apply(lambda v: min(20.0, v * 30.0))

    # Factor 4: Active disruption indicator
    disruption_penalty = df["disruption_indicator"].apply(lambda flag: 20.0 if flag else 0.0)

    # Aggregate Risk Score (0-100)
    df["risk_score"] = (otd_penalty + defect_penalty + lt_penalty + disruption_penalty).round(1)
    df["risk_score"] = df["risk_score"].clip(0.0, 100.0)

    # Categorize Risk
    def categorize(score):
        if score >= 60.0:
            return "High"
        elif score >= 30.0:
            return "Medium"
        return "Low"

    df["risk_category"] = df["risk_score"].apply(categorize)

    # Identify primary risk drivers
    def identify_factors(row):
        factors = []
        if row["disruption_indicator"]:
            factors.append("Active External Disruption")
        if row["on_time_delivery_rate"] < 0.75:
            factors.append(f"Low OTD ({row['on_time_delivery_rate']*100:.0f}%)")
        if row["defect_rate"] >= 0.03:
            factors.append(f"High Defect Rate ({row['defect_rate']*100:.1f}%)")
        if row["avg_lead_time_days"] > row["promised_lead_time_days"] + 3:
            delay = row["avg_lead_time_days"] - row["promised_lead_time_days"]
            factors.append(f"Lead-time Slip (+{delay}d)")
        if not factors:
            factors.append("Operations Normal")
        return ", ".join(factors)

    df["main_risk_factors"] = df.apply(identify_factors, axis=1)
    return df


