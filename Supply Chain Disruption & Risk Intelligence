    # TAB 2: SUPPLIER RISK ANALYSIS
    with tab2:
        st.subheader("Supplier Resilience & Risk Scores")
        st.markdown(
            "Suppliers evaluated on a transparent 0–100 scale combining On-Time Delivery (35%), Defect Rate (25%), "
            "Lead Time Slippage (20%), and Active Disruption Flags (20%)."
