# Main Application Flow & UI
# ---------------------------------------------------------
def main():
    # Load deterministic data
    raw_suppliers, raw_inventory, raw_production, raw_shipments, base_date = generate_sample_data()

    # Compute risk models
    suppliers_scored = calculate_supplier_risk(raw_suppliers)
    inventory_scored = calculate_inventory_risk(raw_inventory, suppliers_scored)
    production_scored = calculate_production_risk(raw_production, inventory_scored, suppliers_scored, raw_shipments, base_date)
    recommendations_df = generate_recommendations(suppliers_scored, inventory_scored, production_scored, raw_shipments)

