# 4. Production Disruption Analysis Engine
# ---------------------------------------------------------
def calculate_production_risk(df_production, df_inventory_scored, df_suppliers_scored, df_shipments, base_date):
    """
    Correlates production schedules with inventory stockouts, supplier distress,
    and shipment delays. Provides clear, traceable reasons for risk assignments.
    """
    inv_map = df_inventory_scored.set_index("material_id").to_dict(orient="index")
    sup_map = df_suppliers_scored.set_index("supplier_id").to_dict(orient="index")

    # Group shipments by material_id to detect active delays
    delayed_shipments_by_mat = {}
    for _, s in df_shipments.iterrows():
        if s["delay_status"] in ["Delayed", "Critical Delay"]:
            mat = s["material_id"]
            delayed_shipments_by_mat[mat] = delayed_shipments_by_mat.get(mat, []) + [s["shipment_id"]]

    production_records = []

    for _, row in df_production.iterrows():
        order_id = row["order_id"]
        product_name = row["product_name"]
        required_mats = row["required_materials"]
        priority = row["order_priority"]
        status = row["production_status"]
        start_date = row["planned_start_date"]
        comp_date = row["planned_completion_date"]

        days_until_start = (start_date - base_date).days
        lead_window_days = (comp_date - base_date).days

        reasons = []
        mitigations = []
        critical_shortage = False
        moderate_risk = False

        for mat_id in required_mats:
            mat_info = inv_map.get(mat_id)
            if not mat_info:
                continue

            days_remaining = mat_info["days_of_inventory_remaining"]
            reorder_lt = mat_info["reorder_lead_time_days"]
            sup_id = mat_info["primary_supplier_id"]
            sup_info = sup_map.get(sup_id, {})

            # Reason 1: Inventory stockout before replenishment
            if days_remaining <= days_until_start or days_remaining < reorder_lt:
                reasons.append(f"{mat_id} stockout in {days_remaining:.0f}d (Reorder LT: {reorder_lt}d)")
                critical_shortage = True
                mitigations.append(f"Expedite emergency stock for {mat_id}")

            # Reason 2: High-risk or disrupted supplier
            if sup_info.get("risk_category") == "High":
                reasons.append(f"Supplier {sup_id} for {mat_id} is High-Risk ({sup_info.get('risk_score', 0):.0f}/100)")
                moderate_risk = True
                mitigations.append(f"Activate qualified backup source for {mat_id}")

            # Reason 3: Delayed incoming shipment
            if mat_id in delayed_shipments_by_mat:
                shipment_ids = ", ".join(delayed_shipments_by_mat[mat_id])
                reasons.append(f"Shipment {shipment_ids} delayed for {mat_id}")
                moderate_risk = True
                mitigations.append(f"Expedite shipment via air freight or reroute")

        # Reason 4: Schedule tightness
        if lead_window_days <= 10 and (critical_shortage or moderate_risk):
            reasons.append("Tight production buffer (<10d remaining)")
            mitigations.append("Adjust shopfloor schedule or reprioritize batch")

        # Determine overall order risk level
        if critical_shortage or (priority in ["High", "Critical"] and moderate_risk):
            order_risk = "High"
        elif moderate_risk or len(reasons) > 0:
            order_risk = "Medium"
        else:
            order_risk = "Low"
            reasons.append("Materials available and suppliers operational")
            mitigations.append("Maintain standard production schedule")

        production_records.append({
            "order_id": order_id,
            "product_name": product_name,
            "required_materials": ", ".join(required_mats),
            "order_priority": priority,
            "production_status": status,
            "order_risk_level": order_risk,
            "risk_reason": "; ".join(reasons),
            "recommended_mitigation": "; ".join(dict.fromkeys(mitigations))  # Deduplicate while preserving order
        })

    return pd.DataFrame(production_records)


# ---------------------------------------------------------
# 5. Rule-Based Mitigation Recommendation Engine
# ---------------------------------------------------------
def generate_recommendations(df_suppliers_scored, df_inventory_scored, df_production_scored, df_shipments):
    """
    Generates deterministic, structured mitigation recommendations across
    suppliers, inventory materials, shipments, and production lines.
    """
    recommendations = []

    # 1. Supplier-Specific Rules
    for _, sup in df_suppliers_scored.iterrows():
        if sup["risk_category"] == "High":
            recommendations.append({
                "Target Category": "Supplier",
                "Target ID": sup["supplier_id"],
                "Entity Name": sup["supplier_name"],
                "Identified Risk": f"High Supplier Risk (Score: {sup['risk_score']})",
                "Supporting Reason": sup["main_risk_factors"],
                "Proposed Action": "Engage secondary supplier for dual-sourcing; schedule immediate operational alignment call."
            })
        elif sup["defect_rate"] >= 0.04:
            recommendations.append({
                "Target Category": "Supplier",
                "Target ID": sup["supplier_id"],
                "Entity Name": sup["supplier_name"],
                "Identified Risk": f"Elevated Defect Rate ({sup['defect_rate']*100:.1f}%)",
                "Supporting Reason": "Incoming batches exceed acceptable quality limit (AQL 2.0%).",
                "Proposed Action": "Implement 100% incoming QA inspection and issue formal Corrective Action Request (CAPA)."
            })

    # 2. Inventory-Specific Rules
    for _, inv in df_inventory_scored.iterrows():
        if inv["stockout_risk_category"] == "High":
            recommendations.append({
                "Target Category": "Inventory",
                "Target ID": inv["material_id"],
                "Entity Name": inv["material_name"],
                "Identified Risk": f"Critical Stockout Coverage ({inv['days_of_inventory_remaining']:.1f} days left)",
                "Supporting Reason": f"Current stock ({inv['current_stock']} units) below reorder lead time ({inv['reorder_lead_time_days']} days).",
                "Proposed Action": "Place emergency replenishment order with expedited courier; transfer safety buffer from alternate facility."
            })
        elif inv["safety_stock_shortfall"] > 0:
            recommendations.append({
                "Target Category": "Inventory",
                "Target ID": inv["material_id"],
                "Entity Name": inv["material_name"],
                "Identified Risk": f"Safety Stock Shortfall ({inv['safety_stock_shortfall']} units)",
                "Supporting Reason": f"Stock level is below mandated safety threshold ({inv['safety_stock']} units).",
                "Proposed Action": "Reorder safety buffer increment to protect against upcoming batch consumption spikes."
            })

    # 3. Shipment-Specific Rules
    for _, shp in df_shipments.iterrows():
        if shp["delay_status"] in ["Delayed", "Critical Delay"]:
            recommendations.append({
                "Target Category": "Logistics",
                "Target ID": shp["shipment_id"],
                "Entity Name": f"{shp['origin']} → {shp['destination']}",
                "Identified Risk": f"Shipment Disruption ({shp['delay_status']})",
                "Supporting Reason": f"Material {shp['material_id']} transit via {shp['transport_mode']} delayed past planned arrival.",
                "Proposed Action": "Contact freight forwarder for carrier priority escalation or initiate split air cargo batch."
            })

    # 4. Production-Specific Rules
    for _, po in df_production_scored.iterrows():
        if po["order_risk_level"] == "High":
            recommendations.append({
                "Target Category": "Production",
                "Target ID": po["order_id"],
                "Entity Name": po["product_name"],
                "Identified Risk": f"High Production Disruption Risk ({po['order_priority']} Priority)",
                "Supporting Reason": po["risk_reason"],
                "Proposed Action": po["recommended_mitigation"]
            })

    return pd.DataFrame(recommendations)


