    st.sidebar.markdown("---")

    # Filter 1: Supplier filter
    supplier_options = ["All"] + sorted(suppliers_scored["supplier_name"].tolist())
    selected_supplier = st.sidebar.selectbox("Filter by Supplier", supplier_options)

    # Filter 2: Risk category filter
    risk_options = ["All", "High", "Medium", "Low"]
    selected_risk = st.sidebar.selectbox("Filter by Risk Category", risk_options)

    # Filter 3: Production Priority filter
    priority_options = ["All", "Critical", "High", "Medium", "Low"]
    selected_priority = st.sidebar.selectbox("Filter by Order Priority", priority_options)

    st.sidebar.markdown("---")
    st.sidebar.info(
        "💡 **Operational Note**: Predictions and risk scores are deterministic rule-based indicators "
        "designed for early intervention. They do not replace human operational authority."
    )

    # Apply filters
    filtered_suppliers = suppliers_scored.copy()
    if selected_supplier != "All":
        filtered_suppliers = filtered_suppliers[filtered_suppliers["supplier_name"] == selected_supplier]
    if selected_risk != "All":
        filtered_suppliers = filtered_suppliers[filtered_suppliers["risk_category"] == selected_risk]

    filtered_inventory = inventory_scored.copy()
    if selected_supplier != "All":
        sup_id = suppliers_scored.loc[suppliers_scored["supplier_name"] == selected_supplier, "supplier_id"].values[0]
        filtered_inventory = filtered_inventory[filtered_inventory["primary_supplier_id"] == sup_id]
    if selected_risk != "All":
        filtered_inventory = filtered_inventory[filtered_inventory["stockout_risk_category"] == selected_risk]

    filtered_production = production_scored.copy()
    if selected_risk != "All":
        filtered_production = filtered_production[filtered_production["order_risk_level"] == selected_risk]
    if selected_priority != "All":
        filtered_production = filtered_production[filtered_production["order_priority"] == selected_priority]

    filtered_recommendations = recommendations_df.copy()
    if selected_risk != "All":
        filtered_recommendations = filtered_recommendations[filtered_recommendations["Identified Risk"].str.contains(selected_risk, case=False, na=False)]

    # ---------------------------------------------------------
    # Dashboard Header & Operational Summary
    # ---------------------------------------------------------
    st.title("🛡️ Supply Chain Disruption & Risk Intelligence")
    st.markdown(
        "Real-time operational dashboard analyzing supplier resilience, material stockout vulnerabilities, "
        "production order bottlenecks, and delayed freight logistics."
    )

    # KPI Summary Cards
    col1, col2, col3, col4 = st.columns(4)
    with col1:
        high_risk_sup = int((suppliers_scored["risk_category"] == "High").sum())
        st.metric("High-Risk Suppliers", high_risk_sup, delta=f"{high_risk_sup} of {len(suppliers_scored)} suppliers", delta_color="inverse")

    with col2:
        stockout_inv = int((inventory_scored["stockout_risk_category"] == "High").sum())
        st.metric("Materials at Stockout Risk", stockout_inv, delta=f"{stockout_inv} below safety buffer", delta_color="inverse")

    with col3:
        risk_po = int((production_scored["order_risk_level"] == "High").sum())
        st.metric("Orders at Risk", risk_po, delta=f"{risk_po} critical disruptions", delta_color="inverse")

    with col4:
        delayed_shp = int((raw_shipments["delay_status"].isin(["Delayed", "Critical Delay"])).sum())
        st.metric("Delayed Shipments", delayed_shp, delta=f"{delayed_shp} of {len(raw_shipments)} in-transit", delta_color="inverse")

    # Short Operational Summary Banner
    st.markdown("### 📋 Executive Operational Summary")
    st.warning(
        f"**Critical Vulnerability Alert**: Found **{high_risk_sup} high-risk suppliers** (notably Apex Microelectronics and Pacific Sensor Tech experiencing active disruptions), "
        f"**{stockout_inv} materials facing stockout** before replenishment lead times, and **{risk_po} production orders** vulnerable to schedule delays. "
        f"**{delayed_shp} active shipments** require immediate carrier escalation to avoid plant stoppage."
    )

    # ---------------------------------------------------------
    # Detailed Views via Tabs
    # ---------------------------------------------------------
    tab1, tab2, tab3, tab4, tab5 = st.tabs([
        "⚡ Mitigation Engine",
        "🏭 Supplier Risk Analysis",
        "📊 Inventory Risk & Stockout",
        "⚙️ Production Disruption",
        "🚢 Logistics & Shipments"
    ])

